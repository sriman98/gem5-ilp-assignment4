From 36df907415aebb9ff5611b341db4cf12e068d136 Mon Sep 17 00:00:00 2001
From: Sriman Cherukuru <sriman.cherukuru@bectran.com>
Date: Sun, 13 Sep 2026 13:15:02 -0500
Subject: [PATCH 1/2] cpu/pred: add StaticBP, a static always-(not-)taken
 direction predictor for the ILP assignment

---
 src/cpu/pred/BranchPredictor.py | 16 ++++++++++
 src/cpu/pred/SConscript         |  4 ++-
 src/cpu/pred/static_bp.cc       | 56 +++++++++++++++++++++++++++++++++
 src/cpu/pred/static_bp.hh       | 54 +++++++++++++++++++++++++++++++
 4 files changed, 129 insertions(+), 1 deletion(-)
 create mode 100644 src/cpu/pred/static_bp.cc
 create mode 100644 src/cpu/pred/static_bp.hh

diff --git a/src/cpu/pred/BranchPredictor.py b/src/cpu/pred/BranchPredictor.py
index 956153a972..ae95a681fc 100644
--- a/src/cpu/pred/BranchPredictor.py
+++ b/src/cpu/pred/BranchPredictor.py
@@ -264,6 +264,22 @@ class LocalBP(ConditionalPredictor):
     localCtrBits = Param.Unsigned(2, "Bits per counter")
 
 
+class StaticBP(ConditionalPredictor):
+    """Static (non-learning) direction predictor added for the ILP
+    assignment: every conditional branch is predicted with one fixed
+    direction, so the pipeline gets no dynamic branch prediction."""
+
+    type = "StaticBP"
+    cxx_class = "gem5::branch_prediction::StaticBP"
+    cxx_header = "cpu/pred/static_bp.hh"
+
+    predictTaken = Param.Bool(
+        False,
+        "Fixed direction for every conditional branch: False = always "
+        "not-taken (fall through), True = always taken",
+    )
+
+
 class TournamentBP(ConditionalPredictor):
     type = "TournamentBP"
     cxx_class = "gem5::branch_prediction::TournamentBP"
diff --git a/src/cpu/pred/SConscript b/src/cpu/pred/SConscript
index 1f49830fc9..bca40389d9 100644
--- a/src/cpu/pred/SConscript
+++ b/src/cpu/pred/SConscript
@@ -48,7 +48,8 @@ SimObject('BranchPredictor.py',
     'IndirectPredictor', 'SimpleIndirectPredictor',
     'BranchTargetBuffer', 'SimpleBTB', 'BTBIndexingPolicy', 'BTBSetAssociative',
     'ReturnAddrStack',
-    'LocalBP', 'TournamentBP', 'BiModeBP', 'TAGEBase', 'TAGE', 'LoopPredictor',
+    'LocalBP',
+        'StaticBP', 'TournamentBP', 'BiModeBP', 'TAGEBase', 'TAGE', 'LoopPredictor',
     'TAGE_SC_L_TAGE', 'TAGE_SC_L_TAGE_64KB', 'TAGE_SC_L_TAGE_8KB',
     'LTAGE', 'TAGE_SC_L_LoopPredictor', 'StatisticalCorrector', 'TAGE_SC_L',
     'TAGE_SC_L_64KB_StatisticalCorrector',
@@ -64,6 +65,7 @@ SimObject('BranchPredictor.py',
 
 Source('bpred_unit.cc')
 Source('2bit_local.cc')
+Source('static_bp.cc')
 Source('simple_indirect.cc')
 Source('conditional.cc')
 Source('indirect.cc')
diff --git a/src/cpu/pred/static_bp.cc b/src/cpu/pred/static_bp.cc
new file mode 100644
index 0000000000..765ca96163
--- /dev/null
+++ b/src/cpu/pred/static_bp.cc
@@ -0,0 +1,56 @@
+/*
+ * StaticBP -- static direction predictor (see static_bp.hh).
+ */
+
+#include "cpu/pred/static_bp.hh"
+
+#include "base/trace.hh"
+#include "debug/Fetch.hh"
+
+namespace gem5
+{
+
+namespace branch_prediction
+{
+
+StaticBP::StaticBP(const StaticBPParams &params)
+    : ConditionalPredictor(params),
+      predictTaken(params.predictTaken)
+{
+    DPRINTF(Fetch, "StaticBP: every conditional branch is predicted %s\n",
+            predictTaken ? "taken" : "not-taken");
+}
+
+void
+StaticBP::branchPlaceholder(ThreadID tid, Addr pc, bool uncond,
+                            void * &bp_history)
+{
+    // No predictor state, so there is no history object to create.
+}
+
+void
+StaticBP::updateHistories(ThreadID tid, Addr pc, bool uncond, bool taken,
+                          Addr target, const StaticInstPtr &inst,
+                          void * &bp_history)
+{
+    // A static predictor keeps no history.
+}
+
+bool
+StaticBP::lookup(ThreadID tid, Addr pc, void * &bp_history)
+{
+    DPRINTF(Fetch, "StaticBP: branch %#x predicted %s\n", pc,
+            predictTaken ? "taken" : "not-taken");
+    return predictTaken;
+}
+
+void
+StaticBP::update(ThreadID tid, Addr pc, bool taken, void * &bp_history,
+                 bool squashed, const StaticInstPtr &inst, Addr target)
+{
+    // Nothing is learned from the outcome: the prediction never changes.
+    assert(bp_history == NULL);
+}
+
+} // namespace branch_prediction
+} // namespace gem5
diff --git a/src/cpu/pred/static_bp.hh b/src/cpu/pred/static_bp.hh
new file mode 100644
index 0000000000..5124a1775f
--- /dev/null
+++ b/src/cpu/pred/static_bp.hh
@@ -0,0 +1,54 @@
+/*
+ * StaticBP -- a static (non-learning) conditional branch direction
+ * predictor, written for the ILP assignment (Assignment 4) as the
+ * "no dynamic branch prediction" baseline.  Every conditional branch is
+ * predicted with the same fixed direction (always-not-taken by default,
+ * or always-taken), so the predictor never adapts to program behaviour.
+ * It keeps no per-branch state, therefore bp_history is always NULL,
+ * exactly like LocalBP (cpu/pred/2bit_local.hh), which served as the
+ * template for this class.
+ */
+
+#ifndef __CPU_PRED_STATIC_BP_HH__
+#define __CPU_PRED_STATIC_BP_HH__
+
+#include "base/types.hh"
+#include "cpu/pred/conditional.hh"
+#include "params/StaticBP.hh"
+
+namespace gem5
+{
+
+namespace branch_prediction
+{
+
+class StaticBP : public ConditionalPredictor
+{
+  public:
+    StaticBP(const StaticBPParams &params);
+
+    bool lookup(ThreadID tid, Addr pc, void * &bp_history) override;
+
+    void branchPlaceholder(ThreadID tid, Addr pc, bool uncond,
+                           void * &bp_history) override;
+
+    void updateHistories(ThreadID tid, Addr pc, bool uncond, bool taken,
+                         Addr target, const StaticInstPtr &inst,
+                         void * &bp_history) override;
+
+    void update(ThreadID tid, Addr pc, bool taken,
+                void * &bp_history, bool squashed,
+                const StaticInstPtr &inst, Addr target) override;
+
+    void squash(ThreadID tid, void * &bp_history) override
+    { assert(bp_history == NULL); }
+
+  private:
+    /** The one direction every conditional branch is predicted with. */
+    const bool predictTaken;
+};
+
+} // namespace branch_prediction
+} // namespace gem5
+
+#endif // __CPU_PRED_STATIC_BP_HH__
-- 
